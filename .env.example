# Cổng chạy server
PORT=3000

# Tài khoản root (tạo tự động ở lần chạy đầu tiên, sau đó đổi mật khẩu trong /admin)
ADMIN_USER=admin
ADMIN_PASSWORD=doi-mat-khau-nay

# Chuỗi bí mật để ký phiên đăng nhập (để trống sẽ tự sinh và lưu trong data/secret.key)
SESSION_SECRET=

# Thư mục lưu dữ liệu (content.json, users.json, uploads/, backups/)
DATA_DIR=./data

# Dung lượng tối đa khi upload video (MB)
MAX_VIDEO_MB=200
